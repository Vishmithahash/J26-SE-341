DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"

# Shared Authentication Configuration
# Provide a cryptographically secure random secret (e.g. python -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"
AUTH_JWT_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES="15"
# Optional JWT claims
# AUTH_JWT_ISSUER="agentic-qa-framework"
# AUTH_JWT_AUDIENCE="agentic-qa-api"

# Shared LLM Provider Configuration
# Hosted Google Gemini API (Server-side API key header)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Local Ollama / Qwen Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.5:4b"

# Hosted Gemini is never called unless explicitly enabled (credit-consuming).
GEMINI_ENABLED="false"

# Defaults used when neither the caller nor the user's saved selection sets a limit
LLM_DEFAULT_TIMEOUT_SECONDS="180"
LLM_DEFAULT_MAX_TOKENS="2048"

# NexaCart application under test (external QA harness: NexaCart /api/v1/qa/harness)
NEXACART_BASE_URL="http://localhost:3000/api/v1"
NEXACART_QA_ADMIN_EMAIL="admin@nexacart.local"
NEXACART_QA_ADMIN_PASSWORD="set-locally-never-commit"
NEXACART_AGENT_RUN_TIMEOUT_SECONDS="400"
# NexaCart backend root for C1 code diagnosis and disposable correction sandboxes (read-only)
NEXACART_SOURCE_ROOT="D:/Research Project/E-Commerce-Platform/backend"
# C1 candidate correction + sandbox verification / defect lab (planned for progress presentation 2)
C1_CODE_CORRECTION_ENABLED="false"
